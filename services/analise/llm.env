# Configuração do LLM e do RAG (sem segredos, por isso versionada).
# No Kubernetes, os mesmos valores estão em k8s/analise/configmap.yaml.
OLLAMA_URL=http://ollama:11434
LLM_MODELO=qwen2.5:3b
LLM_TEMPERATURA=0.1
LLM_TIMEOUT_S=60
LLM_TENTATIVAS=3
EMBEDDING_MODELO=bge-m3
EMBEDDING_DIMENSAO=1024
CIRCUITO_FALHAS=3
CIRCUITO_ESPERA_S=30
CACHE_TTL_S=600
CACHE_TAMANHO=256
RAG_TRECHOS=3
BASE_CONHECIMENTO_DIR=/app/conhecimento
# Serviços consultados pelas tools da análise (POST /v1/analises).
TERRITORIO_URL=http://territorio:3000
RISCO_URL=http://risco:3000
FONTES_TIMEOUT_S=5
