{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"],
    "paths": {
      "@domain/*": ["./src/@core/domain/*"],
      "@use-cases/*": ["./src/@core/use-cases/*"],
      "@infra/*": ["./src/infra/*"],
      "@app/*": ["./src/app/*"],
      "@ioc/*": ["./src/ioc/*"]
    }
  }
}
