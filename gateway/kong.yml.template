_format_version: "3.0"

services:
  - name: bff-web
    url: http://bff-web:3000
    routes:
      - name: web
        paths: ["/web/v1"]
        strip_path: false
    plugins:
      - name: jwt
        config:
          key_claim_name: iss
          claims_to_verify: ["exp"]
      - name: pluvia-subject-rate-limit
      - name: rate-limiting
        config:
          minute: 300
          limit_by: header
          header_name: X-Pluvia-RateLimit-Subject
          policy: local
      - name: request-transformer
        config:
          remove:
            headers: ["X-Pluvia-RateLimit-Subject"]
      - name: cors
        config:
          origins: ["http://localhost:5173"]
          methods: ["GET", "POST", "PUT", "PATCH", "DELETE"]
          headers: ["Accept", "Authorization", "Content-Type", "Idempotency-Key", "X-Request-ID"]
          exposed_headers: ["X-Request-ID"]
          credentials: true

  - name: bff-mobile
    url: http://bff-mobile:3000
    plugins:
      - name: request-transformer
        config:
          remove:
            headers: ["X-Pluvia-RateLimit-Subject"]
    routes:
      - name: mobile-publico
        paths: ["/mobile/v1/publico"]
        strip_path: false
        plugins:
          - name: cors
            config:
              origins: ["http://localhost:5174"]
              methods: ["GET", "OPTIONS"]
              headers: ["Accept", "Content-Type", "If-None-Match", "X-Request-ID"]
              exposed_headers: ["ETag", "X-Request-ID"]
              credentials: false
          - name: rate-limiting
            config:
              minute: 30
              limit_by: ip
              policy: local
      - name: mobile
        paths: ["/mobile/v1"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              key_claim_name: iss
              claims_to_verify: ["exp"]
          - name: pluvia-subject-rate-limit
          - name: rate-limiting
            config:
              minute: 120
              limit_by: header
              header_name: X-Pluvia-RateLimit-Subject
              policy: local
          - name: cors
            config:
              origins: ["http://localhost:5174"]
              methods: ["GET", "POST", "OPTIONS"]
              headers: ["Accept", "Authorization", "Content-Type", "If-None-Match", "X-Request-ID"]
              exposed_headers: ["ETag", "X-Request-ID"]
              credentials: false

  # Static files of the Keycloak login page (CSS, JS, fonts). One login loads
  # about 10 of them, so they stay out of the 20/min limit of the /auth route,
  # which protects the login and token endpoints.
  - name: keycloak-recursos
    url: http://keycloak:8080/resources
    routes:
      - name: auth-recursos
        paths: ["/auth/resources"]
        methods: ["GET"]
        strip_path: true

  - name: keycloak
    url: http://keycloak:8080
    routes:
      - name: auth
        paths: ["/auth"]
        strip_path: true
    plugins:
      - name: rate-limiting
        config:
          minute: 20
          limit_by: ip
          policy: local
      - name: cors
        config:
          origins: ["http://localhost:5173"]
          methods: ["GET", "POST", "OPTIONS"]
          headers: ["Accept", "Content-Type"]
          credentials: false

consumers:
  - username: pluvia-keycloak
    jwt_secrets:
      - key: __KEYCLOAK_ISSUER_JSON__
        algorithm: RS256
        rsa_public_key: __KEYCLOAK_REALM_PUBLIC_KEY_JSON__

plugins:
  - name: correlation-id
    config:
      header_name: X-Request-ID
      generator: uuid
      echo_downstream: true
  - name: request-size-limiting
    config:
      allowed_payload_size: 1
